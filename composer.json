{
  "name": "juanparati/larageos",
  "description": "A Laravel library that understands and speaks GeoSpatial data types.",
  "keywords": [
    "juanparati",
    "larageos",
    "laravel",
    "spatial",
    "geospatial"
  ],
  "homepage": "https://github.com/juanparati/larageos",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Juan Lago",
      "email": "juanparati@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4|^8.5",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Juanparati\\LaraGeos\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Juanparati\\LaraGeos\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Juanparati\\LaraGeos\\LaraGeosServiceProvider"
      ]
    }
  }
}
